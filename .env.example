# ── API do servidor Éden ───────────────────────────────────────────────────────
EDEN_API_BASE=https://api.eden.net

# ── URL do manifesto do modpack ────────────────────────────────────────────────
EDEN_MODPACK_URL=https://api.eden.net/modpack/manifest.json

# ── Azure AD — Microsoft OAuth2 (obrigatório para login premium) ──────────────
# Crie um App Registration em: https://portal.azure.com
# Tipo de conta: Contas pessoais Microsoft
# Redirect URI: https://login.microsoftonline.com/common/oauth2/nativeclient
EDEN_MS_CLIENT_ID=00000000-0000-0000-0000-000000000000

# ── Supabase — contas centrais (opcional) ─────────────────────────────────────
# Crie um projeto em https://supabase.com → Settings → API.
# Preencha para ativar login central (e-mail + senha); deixe vazio para contas locais.
# Dica: em Authentication → Providers → Email, desative "Confirm e-mail".
EDEN_SUPABASE_URL=
EDEN_SUPABASE_ANON_KEY=
